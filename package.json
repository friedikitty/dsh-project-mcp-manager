{
  "name": "dsh-project-mcp-manager",
  "version": "0.13.0",
  "description": "MCP manager for DSH with default loader and settings UI components: project/global server loading, hot reload, per-session tool visibility, and the dsh-mcp CLI.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "dsh-mcp": "lib/cli.js"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": "^0.2.2-rc.1"
  },
  "license": "MIT",
  "author": "wldxiaobai <944418001@qq.com>",
  "contributors": [
    "friedikitty"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/friedikitty/dsh-project-mcp-manager.git"
  },
  "bugs": {
    "url": "https://github.com/friedikitty/dsh-project-mcp-manager/issues"
  },
  "homepage": "https://github.com/friedikitty/dsh-project-mcp-manager#readme",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "mcp",
    "project",
    "plugin",
    "cordis"
  ],
  "dependencies": {
    "@deepseek-ai/dsh-mcp-client": "0.2.2-rc.1",
    "@deepseek-ai/dsh-subprocess": "0.2.2-rc.1",
    "@modelcontextprotocol/client": "2.2.0",
    "chokidar": "^5.0.0",
    "dsh-project-mcp-ui": "0.13.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "docs",
    "locale",
    "LICENSE"
  ]
}
